# LLMod.ai - the group key is shared by the text and embedding models.
LLM_URL=https://api.llmod.ai/v1
LLM_KEY=
LLM_MODEL=MB5R2CF-azure/gpt-5.4-mini
SAFETY_LLM_MODEL=MB5R2CF-azure/gpt-5.4-mini
SAFETY_REASONING_EFFORT=low

EMBEDDER_URL=https://api.llmod.ai/v1
EMBEDDER_KEY=
EMBEDDER_MODEL=MB5R2CF-azure/text-embedding-3-small

# Supabase
DB_URL=
DB_AUTH_TOKEN=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=carepilot-clinical-rag

# Required submission metadata. Keep the real values in the ignored local .env
# and in Vercel project environment variables, not in Git.
CAREPILOT_GROUP_BATCH_ORDER_NUMBER=<batch>_<presentation-order>
CAREPILOT_TEAM_NAME=<team-name>
CAREPILOT_STUDENTS_JSON=[{"name":"Student A","email":"student-a@example.com"}]

# The public demo opens immediately with this synthetic identity.
CAREPILOT_DEFAULT_USERNAME=patient_1
